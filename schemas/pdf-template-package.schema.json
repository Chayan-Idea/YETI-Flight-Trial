{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YETI PDF Checklist Template Package",
  "type": "object",
  "required": ["packageVersion", "document", "sourcePdf", "template", "sections"],
  "properties": {
    "packageVersion": {"const": 1},
    "document": {
      "type": "object",
      "required": ["templateId", "version", "pageCount", "pageWidth", "pageHeight"],
      "properties": {
        "templateId": {"type": "string"},
        "version": {"type": "string"},
        "pageCount": {"type": "integer", "minimum": 1},
        "pageWidth": {"type": "number", "exclusiveMinimum": 0},
        "pageHeight": {"type": "number", "exclusiveMinimum": 0},
        "orientation": {"enum": ["portrait", "landscape"]}
      }
    },
    "sourcePdf": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "\\.pdf$"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "template": {
      "type": "object",
      "required": ["page", "rows", "columns"],
      "properties": {
        "page": {"type": "object", "required": ["width", "height", "unit"]},
        "rows": {"type": "object"},
        "columns": {"type": "object"}
      }
    },
    "sections": {"type": "array"}
  },
  "additionalProperties": false
}
