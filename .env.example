# GitHub OAuth App credentials; callback URL ends with /api/auth/callback/github
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Server-side token with Contents read/write access to this private repository
GITHUB_TOKEN=
GITHUB_OWNER=Chayan-Idea
GITHUB_REPO=YETI-Flight-Trial
GITHUB_BRANCH=feature/document-library-v1

# Comma-separated GitHub usernames permitted to sign in
AUTHORIZED_GITHUB_USERS=your-github-username
